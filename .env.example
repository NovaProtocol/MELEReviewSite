# MELE Review: environment variables
# Documentation only. There is no .env file: values come from compose
# interpolation in compose.yaml or from your shell.

# === Deployment ===
# debug      -> DEBUG on, cookies not Secure (plain HTTP on a LAN)
# production -> Secure cookies, strict cache policy
DEPLOYMENT_TYPE=debug

# === Database ===
# MySQL root password. Also the app's database password.
MYSQL_PASS=change-me-to-a-strong-password
# MYSQL_HOST=mysql-db
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=MELEReview
# DATABASE_URL=mysql+aiomysql://root:changeme@mysql-db:3306/MELEReview

# === Secrets ===
# Session signing key, at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-must-be-at-least-32-characters-long

# === System administrator ===
# The account with every permission and the only one that can open /admin.
# Created on first boot if it does not exist. ADMIN_PASS is reconciled on every
# start, so the environment always wins over a password changed in the UI.
ADMIN_USER=admin
ADMIN_PASS=password

# === Uploads ===
# Where solution images and avatars are written, inside the container.
UPLOAD_DIR=/app/uploads
# Largest accepted image, in bytes. Default 8 MiB.
MAX_UPLOAD_BYTES=8388608

# === Invitations ===
# How many unused codes a member may hold at once.
MAX_OPEN_INVITES=5

# === Cookies ===
# Leave blank to derive it from DEPLOYMENT_TYPE (Secure when production).
# Set to false when serving production over plain HTTP, or the browser discards
# the session cookie and sign-in never sticks.
# COOKIE_SECURE=false
