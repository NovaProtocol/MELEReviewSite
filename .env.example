# MELE Review: Environment Variables
# Documentation only: there is NO .env file; values come from compose
# interpolation (${VAR:?} in compose.yaml) or your shell.

# === Required ===
# DEPLOYMENT_TYPE controls DEBUG flag and cookie security.
#   debug  -> DEBUG=true, cookies not Secure (local http)
#   production -> DEBUG=false, Secure cookies, stricter settings
DEPLOYMENT_TYPE=debug
# MySQL root password: must match mysql service / compose
MYSQL_PASS=change-me-to-a-strong-password
# SECRET_KEY must be at least 32 characters (generate with: openssl rand -hex 32)
# Used for session cookie signing (itsdangerous) and any future signing.
SECRET_KEY=changeme-must-be-at-least-32-characters-long

# === Optional (with defaults) ===
# MySQL connection: defaults shown; override if not using compose network
# MYSQL_HOST=mysql-db
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_DATABASE=MELEReview

# DATABASE_URL overrides individual MYSQL_* vars (full SQLAlchemy URL).
# Useful for tests / alternate drivers: sqlite+aiosqlite:///./app.db
# For prod this is built as: mysql+aiomysql://USER:PASS@HOST:PORT/DB
# DATABASE_URL=mysql+aiomysql://root:changeme@mysql-db:3306/MELEReview
# DATABASE_URL=sqlite+aiosqlite:////tmp/dev.db

# CORS allowed origins (comma-separated or JSON list). Defaults to ["*"].
# Example: CORS_ALLOW_ORIGINS=["https://example.com","https://app.example.com"]
# CORS_ALLOW_ORIGINS=["*"]

# gRPC internal (container-to-container, not published)
# web -> api via grpc.aio.insecure_channel("melereview_api:50051")
# Public traffic stays HTTP via Caddy handle /api/* -> api:8082
# API_GRPC_ADDR=melereview_api:50051

# Observability (optional):
# structlog JSON logging auto-enables if structlog is installed.
# X-Request-ID header is always added by RequestIDMiddleware; account_id is
# bound to logs when a valid session cookie is present.
